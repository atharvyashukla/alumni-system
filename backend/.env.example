# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for local PostgreSQL: postgresql://postgres:postgres@localhost:5432/alumni_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alumni_db?schema=public"

# JWT Secret for signing session tokens
JWT_SECRET=super_secret_jwt_key_change_in_production_12345

# Google OAuth Credentials (for Step 2)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# LinkedIn OAuth Credentials (for Step 2)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_CALLBACK_URL=http://localhost:5000/auth/linkedin/callback

# Google Gemini API Key (for Step 4 AI Mentorship Matching)
GEMINI_API_KEY=your_gemini_api_key_here
